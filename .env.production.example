# =============================================================================
# Zoro English Academy - Production Environment Configuration Template
# =============================================================================
# IMPORTANT:
# 1. Copy this template to .env.production on your VPS:
#    cp .env.production.example .env.production
# 2. Populate all REPLACE_WITH_* placeholders with real production credentials.
# 3. Protect this file with strict Linux permissions:
#    chmod 600 .env.production
# 4. NEVER commit .env.production or any file containing live credentials to git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# The database container connects internally on the Docker network.
# Port 5432 is NEVER exposed to the public internet.
DB_NAME=zoro_academy
DB_USER=postgres
# Generate a secure random password: openssl rand -hex 24
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD

# -----------------------------------------------------------------------------
# 2. Authentication & Cryptography Secrets (REQUIRED)
# -----------------------------------------------------------------------------
# Generate a 256-bit+ Base64 string: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_256BIT_RANDOM_JWT_SECRET
JWT_EXPIRATION_MS=3600000
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Initial Super Administrator Account
ADMIN_EMAIL=admin@zoroenglish.com
# Strong initial password (change immediately after first login)
ADMIN_PASSWORD=REPLACE_WITH_SECURE_INITIAL_ADMIN_PASSWORD

# Key for encrypting reversible student credentials for admin inspection (min 16 chars)
# Generate using: openssl rand -base64 32
ADMIN_PASSWORD_KEY=REPLACE_WITH_BASE64_32CHAR_ADMIN_PASSWORD_KEY

# -----------------------------------------------------------------------------
# 3. Domain & CORS Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Comma-separated list of origins permitted to call api.zoroenglish.com
CORS_ORIGINS=https://zoroenglish.com,https://www.zoroenglish.com

# -----------------------------------------------------------------------------
# 4. Bunny Storage Configuration (Documents, Audio, Images) (REQUIRED)
# -----------------------------------------------------------------------------
APP_STORAGE_PROVIDER=bunny
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=REPLACE_WITH_BUNNY_STORAGE_ZONE_NAME
BUNNY_STORAGE_PASSWORD=REPLACE_WITH_BUNNY_STORAGE_PASSWORD_OR_API_KEY
BUNNY_STORAGE_CDN_HOST=REPLACE_WITH_BUNNY_STORAGE_PULLZONE_HOST.b-cdn.net

# -----------------------------------------------------------------------------
# 5. Bunny Stream Configuration (Video Delivery & HLS Transcoding) (REQUIRED)
# -----------------------------------------------------------------------------
BUNNY_LIBRARY_ID=REPLACE_WITH_BUNNY_STREAM_LIBRARY_ID
BUNNY_API_KEY=REPLACE_WITH_BUNNY_STREAM_API_KEY
BUNNY_CDN_HOST=REPLACE_WITH_BUNNY_STREAM_CDN_HOST.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=REPLACE_WITH_BUNNY_STREAM_TOKEN_AUTH_KEY
BUNNY_WEBHOOK_SECRET=REPLACE_WITH_BUNNY_STREAM_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (Live Credentials) (REQUIRED for Payments)
# -----------------------------------------------------------------------------
# Obtain from Razorpay Dashboard in Live Mode (rzp_live_...)
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# 7. Email Service Configuration (Brevo Transactional API / AWS SES Fallback)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
EMAIL_SENDER_EMAIL=zorocentre@gmail.com
EMAIL_SENDER_NAME="Zoro English Academy"

# AWS SES SMTP Email Delivery (Fallback)
AWS_SES_HOST=email-smtp.ap-south-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_USERNAME=REPLACE_WITH_AWS_SES_SMTP_USERNAME
AWS_SES_PASSWORD=REPLACE_WITH_AWS_SES_SMTP_PASSWORD
AWS_SES_FROM_EMAIL=zorocentre@gmail.com
AWS_SES_FROM_NAME="Zoro English Academy"

# -----------------------------------------------------------------------------
# 8. Operational Defaults (OPTIONAL)
# -----------------------------------------------------------------------------
SCHEDULE_RESOURCES_UNLOCK_MINUTES=30
ATTENDANCE_CORRECTION_WINDOW_MINUTES=60
