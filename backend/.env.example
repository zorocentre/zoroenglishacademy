# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoro_academy
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Security (Must be a Base64-encoded key of at least 32 bytes / 256 bits)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_here
JWT_EXPIRATION=86400000

# Bunny Stream Video Storage & Streaming
BUNNY_LIBRARY_ID=your_bunny_library_id_here
BUNNY_API_KEY=your_bunny_stream_api_key_here
BUNNY_CDN_HOST=your_pullzone.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=your_bunny_stream_token_auth_key_here
BUNNY_WEBHOOK_SECRET=your_bunny_webhook_secret_here

# Initial Administrator Credentials (Required for bootstrapping admin account)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_PASSWORD_KEY=your_32_byte_aes_key_or_secret_here

# Bunny Storage (PDFs, Audio, and Study Materials)
APP_STORAGE_PROVIDER=bunny
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=your_bunny_storage_zone_name_here
BUNNY_STORAGE_PASSWORD=your_bunny_storage_read_write_password_here
BUNNY_STORAGE_CDN_HOST=your_storage_pullzone.b-cdn.net

# Email Service Configuration (Brevo Transactional API / AWS SES Fallback)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_SENDER_EMAIL=zorocentre@gmail.com
EMAIL_SENDER_NAME="Zoro English Academy"

# SMTP / Email Configuration (AWS SES / Standard SMTP Fallback)
AWS_SES_HOST=email-smtp.ap-south-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_USERNAME=your_ses_smtp_username_here
AWS_SES_PASSWORD=your_ses_smtp_password_here
AWS_SES_FROM_EMAIL=zorocentre@gmail.com
AWS_SES_FROM_NAME="Zoro English Academy"

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
